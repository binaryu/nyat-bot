# ============================================================
# NyatBot 核心环境变量模板 (Quick Start)
# 复制此文件为 `.env` 并填写对应的值即可启动运行。
# 完整 360+ 环境变量详细说明与高级特性配置，请参阅: docs/env.md
# ============================================================

# ── 1. Telegram Bot (必填) ──
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
BOT_USERNAME=xxb_bot
MASTER_UID=0 
BOT_NICKNAMES=哈基米     

# ── 2. 基础存储与服务 (必填) ──
REDIS_URL=redis://127.0.0.1:6379/0
SQLITE_PATH=./data/xxb.db
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── 3. AI 模型提供商与使用部门路由 (必填) ──
# 核心 Usage 部门: reply (回复) / judge (判断/流控) / summarize (总结) / vision (视觉)
AI_PROVIDER_REPLY_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_REPLY_KEY=sk-***
AI_PROVIDER_REPLY_MODEL=gpt-4o-mini

AI_PROVIDER_JUDGE_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_JUDGE_KEY=sk-***
AI_PROVIDER_JUDGE_MODEL=gpt-4o-mini

AI_PROVIDER_SUMMARIZE_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_SUMMARIZE_KEY=sk-***
AI_PROVIDER_SUMMARIZE_MODEL=gpt-4o-mini

AI_PROVIDER_VISION_ENDPOINT=https://api.openai.com/v1
AI_PROVIDER_VISION_KEY=sk-***
AI_PROVIDER_VISION_MODEL=gpt-4o

AI_USAGE_REPLY_LABEL=reply
AI_USAGE_JUDGE_LABEL=judge
AI_USAGE_SUMMARIZE_LABEL=summarize
AI_USAGE_VISION_LABEL=vision

# ── 4. 天气与主动作息关心 (可选) ──
WEATHER_ENABLED=false              # 开启 wttr.in 免费天气感知
WEATHER_CITY=Shanghai              # 城市名 (拼音或英文)
SLEEP_SCHEDULE_ENABLED=false       # 开启作息系统 (早安/晚安状态机)
SLEEP_DM_ENABLED=false             # 醒来/睡前主动向主人/私聊高好感用户发早安/晚安
UNIFIED_TICK_ENABLED=false         # 统一环境与状态感知的主动决策心跳循环

# ── 5. 长期记忆向量库 Qdrant (可选) ──
# QDRANT_HOST=127.0.0.1
# QDRANT_PORT=6333
# MEMORY_EMBED_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# MEMORY_COLLECTION=xxb_group_history_v2
# MEMORY_MIN_SCORE=0.55

# ── 6. 核心认知流控 (可选) ──
HEART_ENABLED=false                # 一体化认知裁决 Heart 模式 (群聊主推)
TURN_ACTOR_ENABLED=false           # Per-Chat 回合式流控 (MaiBot 风格打断/追击)
TIMING_GATE_ENABLED=false          # MaiBot 节奏控制器门控
CORE_V2_ENABLED=false              # Core v2 统一认知地基 (Belief/Drives/Lifecycle)

# ── 7. 私聊白名单 (DM-ALLOW) ──
DM_ALLOWLIST_ENABLED=false         # 开启后仅白名单用户可与 Bot 私聊
DM_ALLOWLIST_UIDS=                 # 允许私聊的 Telegram UID (逗号分隔)
